# =====================================================================
# Medical IoMT Cybersecurity Risk Prediction System — Environment Config
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Project metadata
PROJECT_NAME="Medical IoMT Cybersecurity Risk Prediction System"
PROJECT_VERSION="1.0.0"

# Database
DATABASE_URL="sqlite:///./medical_iomt_security.db"

# Data paths (relative to project root)
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
SAMPLE_DATA_DIR="data/sample"
MODELS_DIR="models/saved"

# Demo mode — set to False when a real dataset is loaded
DEMO_MODE=True

# ML settings
RANDOM_SEED=42
TEST_SIZE=0.2
N_ESTIMATORS=100

# API settings
API_V1_STR="/api"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Risk score thresholds (0–100)
RISK_LOW_MAX=24
RISK_MEDIUM_MAX=49
RISK_HIGH_MAX=74
